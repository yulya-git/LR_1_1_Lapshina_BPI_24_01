<Window x:Class="LR_1_1_Lapshina_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LR_1_1_Lapshina_BPI_24_01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Column="0" Grid.Row="0">
            <Label>День</Label>
            <TextBox Width="100" Height="20" x:Name="dayInput"/>
        </WrapPanel>

        <WrapPanel Grid.Column="0" Grid.Row="1">
            <Label>Месяц</Label>
            <TextBox Width="100" Height="20" x:Name="monthInput"/>
        </WrapPanel>

        <WrapPanel Grid.Column="0" Grid.Row="2">
            <Label>Год</Label>
            <TextBox Width="100" Height="20" x:Name="yearInput"/>
        </WrapPanel>

        <WrapPanel Grid.Column="0" Grid.Row="3">
            <Button Width="300" Height="30" Content="Увеличить год на 1" x:Name="ButtonAddYear"/>
        </WrapPanel>

        <WrapPanel Grid.Column="0" Grid.Row="4">
            <Button Width="300" Height="30" Content="Уменьшить дату на 2 дня" x:Name="ButtonDeleteDays"/>
        </WrapPanel>
    </Grid>
</Window>
